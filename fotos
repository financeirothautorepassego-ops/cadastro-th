<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fotos dos carros | TH Auto Repasse</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--ouro:linear-gradient(135deg,#a97b1f,#d8b24a 55%,#b8892b);--gold:#c9a84c;--gold2:#e6c76a;--gold3:#8a6a1c;--mut:#6b7280;--line:#e7e2d6;--bg:#f6f4ee}
*{box-sizing:border-box}
body{margin:0;font-family:Poppins,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:#16181d;font-size:14.5px}
header{background:#0b0b0d;color:#fff;padding:14px 20px;border-bottom:2px solid var(--gold)}
header h1{margin:0;font-size:18px;font-weight:800}header h1 span{color:var(--gold2)}
header p{margin:2px 0 0;color:#aeb4bd;font-size:12.5px}
.wrap{max-width:1100px;margin:0 auto;padding:20px}
.drop{border:2px dashed var(--gold);border-radius:18px;background:#fff;padding:34px 20px;text-align:center;cursor:pointer;transition:background .15s}
.drop.over{background:#fbf5e3}
.drop b{font-size:18px;display:block;margin-bottom:4px}.drop small{color:var(--mut)}
.btn{display:inline-flex;align-items:center;gap:6px;border:0;background:var(--ouro);color:#1a1305;border-radius:999px;padding:10px 18px;font:inherit;font-weight:700;font-size:14px;cursor:pointer}
.btn.ghost{background:#fff;color:#16181d;border:1px solid var(--line)}
.btn.wa{background:#25d366;color:#fff}
.btn[disabled]{opacity:.5;cursor:default}
.car{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;margin-top:16px;box-shadow:0 2px 12px rgba(20,16,6,.05)}
.car-h{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.car-h .placa{font-family:ui-monospace,Consolas,monospace;font-size:20px;font-weight:800;letter-spacing:2px}
.car-h .info{color:var(--mut);font-size:13px;flex:1}
.fld{padding:7px 10px;border:1px solid var(--line);border-radius:8px;font:inherit;width:130px;text-transform:uppercase}
.sel{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.ph{position:relative;border:3px solid transparent;border-radius:12px;overflow:hidden;background:#111;cursor:pointer;aspect-ratio:4/3}
.ph img{width:100%;height:100%;object-fit:cover;display:block;opacity:.55}
.ph.on{border-color:var(--gold)}.ph.on img{opacity:1}
.ph .n{position:absolute;left:6px;top:6px;background:var(--ouro);color:#1a1305;border-radius:999px;font-weight:800;font-size:12px;min-width:22px;height:22px;display:none;align-items:center;justify-content:center;padding:0 6px}
.ph.on .n{display:flex}
.ph .l{position:absolute;left:0;right:0;bottom:0;background:rgba(0,0,0,.72);color:#fff;font-size:11px;padding:3px 6px;line-height:1.2}
.more{margin-top:8px}
.acts{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:12px}
.st{font-size:13px;color:var(--mut)}.st.ok{color:#15803d;font-weight:600}.st.err{color:#b91c1c;font-weight:600}
textarea{width:100%;margin-top:10px;border:1px solid var(--line);border-radius:10px;padding:8px;font:12px ui-monospace,Consolas,monospace;min-height:60px}
.aviso{background:#fff7d6;border:1px solid #f1d98a;color:#6b5400;border-radius:12px;padding:10px 14px;font-size:13px;margin-bottom:14px}
.cfg{margin-top:26px;color:var(--mut);font-size:12.5px}
.tar{position:absolute;right:6px;top:6px;background:rgba(0,0,0,.78);color:var(--gold2);border:1px solid var(--gold);border-radius:8px;padding:5px 9px;font:600 11px Poppins,system-ui,sans-serif;cursor:pointer;min-height:30px}
.tar.ok{color:#86efac;border-color:#86efac}
.ed{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:50;display:none;align-items:center;justify-content:center;padding:12px}
.ed-box{background:#fff;border-radius:16px;padding:12px;max-width:640px;width:100%;max-height:100%;overflow:auto}
.ed-t{font-size:13px;margin-bottom:8px;color:#16181d}
.ed-box canvas{width:100%;height:auto;touch-action:none;border-radius:10px;display:block;background:#111}
@media(max-width:600px){.wrap{padding:12px}.btn{min-height:44px}.sel{grid-template-columns:repeat(2,1fr)}.drop{padding:28px 14px}header{padding:12px 14px}}
</style>
</head>
<body>
<header><h1>TH <span>Auto Repasse</span> · Fotos dos carros</h1><p>Escolha o PDF do laudo, confira as fotos e compartilhe ou publique no catálogo.</p></header>
<div class="wrap">
 <div id="avisoCfg" class="aviso" style="display:none"></div>
 <div class="drop" id="drop"><b>📄 Toque para escolher os PDFs dos laudos</b><small>pode ser mais de um · no computador, também dá para arrastar</small><input type="file" id="arq" accept="application/pdf" multiple hidden></div>
 <div class="car" id="pubBox" style="display:none;border:2px solid var(--gold)"><div class="car-h"><b>📋 Para colar na planilha</b><span class="info" id="pubN"></span></div>
  <p class="st" style="margin:0 0 6px">Copie e cole na aba <b>DESTAQUES</b>, na primeira linha vazia da coluna A. As duas colunas entram de uma vez.</p>
  <textarea id="pubTxt" readonly></textarea>
  <div class="acts"><button class="btn" id="pubCopiar">📋 Copiar tudo</button><button class="btn ghost" id="pubLimpar">Limpar lista</button></div></div>
 <div id="lista"></div>
 <p class="cfg">Dica: no celular, baixe o PDF do laudo e toque em “Escolher”. No computador: abra o laudo, Ctrl+P, “Salvar como PDF” e arraste o arquivo aqui. Para tampar a placa, toque em “Tampar placa” na foto e arraste sobre ela.</p>
</div>

<div class="ed" id="ed"><div class="ed-box"><div class="ed-t"><b>Tampar placa:</b> arraste o dedo sobre a placa. Pode fazer mais de uma tarja.</div><canvas id="edCv"></canvas><div class="acts"><button class="btn ghost" id="edDesf">Desfazer</button><button class="btn ghost" id="edLimpa">Limpar</button><button class="btn" id="edOk">Pronto</button></div></div></div>
<script>
/* ============ CONFIGURAÇÃO ============ */
const CFG={
 CLOUD:'ovfzqo6t',            // nome da conta no Cloudinary
 PRESET:'th-autorepasse',     // upload preset (sem assinatura) do Cloudinary
 PASTA:'catalogo',            // pasta no Cloudinary
 LARGURA:1000,                // largura máxima da foto publicada
 PDFJS:'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js',
 PLANILHAS:['https://docs.google.com/spreadsheets/d/e/2PACX-1vTyFZCNfuQhC12cl0uGEJzeSJ_G7Qxz8yXVAJI9dVeYVqNtDOHRWfvDe_2nCTI9Cc-0wZ7MM5NTarGu/pub?output=csv','https://docs.google.com/spreadsheets/d/e/2PACX-1vQkriVjgK8qg6irGz2eBsHOnjLZ412mMbVkjYTXLej81v-B_4vltfN86sgbhwbHnOJCI7quEqRtwN7h/pub?gid=1299741717&single=true&output=csv'], // mesmas planilhas do catálogo: principal e JOPA (a principal vale primeiro)
 TELEFONES:['(62) 99171-6240 — Empresa','(62) 99518-1314 — Thalis'],
 LINK_CATALOGO:'www.thautorepassego.com.br/catalogo'
};
/* Fotos escolhidas automaticamente, nesta ordem (nome que o laudo escreve na foto) */
const PADRAO=[
 ['Frente',/^DIANTEIRA$/],
 ['Diagonal frente dir.',/^DIANTEIRA DIREITA/],
 ['Diagonal frente esq.',/^DIANTEIRA ESQUERDA/],
 ['Traseira',/^TRASEIRA$/],
 ['Diagonal trás esq.',/^TRASEIRA ESQUERDA/],
 ['Diagonal trás dir.',/^TRASEIRA DIREITA/],
 ['Painel (km)',/^HOD[ÔO]METRO/]
];
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const norm=s=>String(s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase().replace(/\s+/g,' ').trim();

/* Lista do dia: tudo que foi publicado fica guardado neste navegador para copiar de uma vez */
let PUB={};try{PUB=JSON.parse(localStorage.getItem('th_fotos_pub')||'{}')}catch(e){}
function salvaPub(){try{localStorage.setItem('th_fotos_pub',JSON.stringify(PUB))}catch(e){}}
function desenhaPub(){
 const k=Object.keys(PUB),b=$('#pubBox');
 if(!k.length){b.style.display='none';return}
 b.style.display='';
 $('#pubN').textContent=k.length+' carro'+(k.length===1?'':'s');
 $('#pubTxt').value=k.map(x=>PUB[x]).join('\n');
}
$('#pubCopiar').onclick=e=>{const t=$('#pubTxt');t.select();try{navigator.clipboard.writeText(t.value)}catch(err){document.execCommand('copy')}e.target.textContent='✅ Copiado! Agora cole na aba DESTAQUES'};
$('#pubLimpar').onclick=()=>{if(confirm('Limpar a lista de carros publicados daqui? (Não apaga nada da planilha nem do Cloudinary.)')){PUB={};salvaPub();desenhaPub();$('#pubCopiar').textContent='📋 Copiar tudo'}};
desenhaPub();

/* ============ ANÚNCIO (código copiado do catálogo, para o texto sair idêntico) ============ */
const CAT=(()=>{
const CONFIG={TELEFONES_ANUNCIO:CFG.TELEFONES,LINK_CATALOGO:CFG.LINK_CATALOGO,REF_ANUNCIO:''};
const norm=s=>String(s??'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]/g,'');
const UFS=new Set('AC AL AP AM BA CE DF ES GO MA MT MS MG PA PB PR PE PI RJ RN RS RO RR SC SP SE TO'.split(' '));
function toNumber(v){
 if(typeof v==='number')return isFinite(v)?v:null;
 let s=String(v??'').replace(/[R$\s]/g,'');
 if(!s||/[#A-Za-z]/.test(s))return null;
 if(s.includes(','))s=s.replace(/\./g,'').replace(',','.');
 else if(/^\d{1,3}(\.\d{3})+$/.test(s))s=s.replace(/\./g,'');
 const n=parseFloat(s);return isFinite(n)?n:null;
}
function kmNumber(v){
 let n;
 if(typeof v==='number')n=Math.round(v);
 else{const s=String(v??'').trim();if(!s||/[a-zA-Z#]/.test(s))return null;n=parseInt(s.replace(/\D/g,''),10);}
 if(!isFinite(n)||n<100||n>400000)return null; // valores absurdos = digitação errada → "a consultar"
 return n;
}
function parseDelimited(text){
 text=text.replace(/^\uFEFF/,'');
 const first=text.split(/\r?\n/)[0]||'';
 const d=['\t',';',','].map(c=>[c,first.split(c).length]).sort((a,b)=>b[1]-a[1])[0][0];
 const rows=[];let row=[],cur='',q=false;
 for(let i=0;i<text.length;i++){const c=text[i];
  if(q){if(c==='"'){if(text[i+1]==='"'){cur+='"';i++}else q=false}else cur+=c}
  else if(c==='"')q=true;
  else if(c===d){row.push(cur);cur=''}
  else if(c==='\n'||c==='\r'){if(c==='\r'&&text[i+1]==='\n')i++;row.push(cur);cur='';rows.push(row);row=[]}
  else cur+=c;
 }
 if(cur!==''||row.length){row.push(cur);rows.push(row)}
 return rows;
}
function parseValidade(v){
 if(v==null||v==='')return null;
 if(typeof v==='number'&&isFinite(v)&&v>30000)return Math.round(Date.UTC(1899,11,30)+v*86400000)+3*3600000;
 const s=String(v).trim();if(!s)return null;
 const m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})(?:[ T,]+(\d{1,2})(?::|h)(\d{2})?(?::(\d{2}))?)?/i);
 if(!m)return null;
 let y=+m[3];if(y<100)y+=2000;
 const temHora=m[4]!==undefined;
 const h=temHora?+m[4]:23,mi=temHora?(+m[5]||0):59,se=temHora?(+m[6]||0):59;
 const t=Date.UTC(y,+m[2]-1,+m[1],h+3,mi,se);
 return isFinite(t)?t:null;
}
const CAMPOS={observacao:'obs',observacoes:'obs',obs:'obs',aviso:'obs',valido:'validade',validoate:'validade',validade:'validade',prazo:'validade',fimpromo:'validade',placa:'placa',modelo:'modelo',anomodelo:'ano',ano:'ano',km:'km',cor:'cor',valorfipe:'fipe',fipe:'fipe',repasse:'repasse',preco:'repasse',uf:'uf',statuslaudo:'laudo',laudo:'laudo',link:'link',promocao:'promo',promo:'promo',promocional:'promo',vendido:'vendido',vendida:'vendido',venda:'vendido',pneus:'pneus',ipva:'ipva',detalhes:'detalhes',detalhe:'detalhes',reparos:'detalhes',manualchave:'manual',manualechave:'manual',manualechavecopia:'manual',fotos:'fotos',foto:'fotos',fotosdocarro:'fotos'};
const AD_PADRAO={pneus:'Bons',manual:'A confirmar',ipva:'2026 PAGO ✅'};
function adLer(){try{return Object.assign({},AD_PADRAO,JSON.parse(localStorage.getItem('th_ad')||'{}'))}catch(e){return Object.assign({},AD_PADRAO)}}
const rs2=n=>n==null?'—':n.toLocaleString('pt-BR',{style:'currency',currency:'BRL',minimumFractionDigits:2,maximumFractionDigits:2}).replace(/\u00a0/g,' ');
const LAUDO_AD={ok:'APROVADO',apont:'APROVADO COM APONTAMENTO',rep:'REPROVADO',none:'A CONFIRMAR'};
const LAUDO_ICO={ok:'✅',apont:'⚠️',rep:'❌',none:'❓'};
function adTexto(v,f){
 const desc=toNumber(f.desc);
 const det=String(f.det||'').trim().replace(/[.,\s]+$/,'');
 const lau=LAUDO_AD[v.laudo]; // o mesmo status aparece em "Laudo:" e dentro de "Detalhes"
 const ipva=f.ipva.trim();
 const semLaudo=v.laudo==='none';
 const fim=v.validade&&!v.encerrado?new Date(v.validade):null;
 const tz={timeZone:'America/Sao_Paulo'};
 const ref=CONFIG.REF_ANUNCIO?'&ref='+encodeURIComponent(CONFIG.REF_ANUNCIO):'';
 const modelo=(v.bruto||(v.familia+' '+v.versao)).toUpperCase();
 const L=[
  '🚗 *'+modelo+'*',
  '📅 '+(v.ano||'—')+'  |  '+(v.km==null?'KM A CONSULTAR':v.km.toLocaleString('pt-BR')+' km')+(v.uf?'  |  📍 '+v.uf:''),
  ...(ipva?['*IPVA '+ipva+'*']:[]),
  '',
  ...(v.fipe?['_FIPE:_ '+rs2(v.fipe)]:[]),
  '🔥 *REPASSE: '+rs2(v.preco)+'*',
  ...(desc&&desc>0?['*'+rs2(desc)+' ABAIXO DA FIPE*']:[]),
  '',
  semLaudo?'📋 _Laudo cautelar: disponível no catálogo_':'📋 _Laudo cautelar: '+lau+' '+LAUDO_ICO[v.laudo]+'_',
  '🏢 *FATURAMENTO PARA CNPJ, QUALQUER SEGMENTO*',
  ...(fim?['⏱ *OFERTA VÁLIDA ATÉ '+fim.toLocaleDateString('pt-BR',{...tz,day:'2-digit',month:'2-digit'})+' ÀS '+fim.toLocaleTimeString('pt-BR',{...tz,hour:'2-digit',minute:'2-digit'})+'*']:[]),
  ...(v.obs?['⚠️ *ATENÇÃO*: '+v.obs.replace(/[.\s]+$/,'')+'.']:[]),
  ...(det?['ℹ️ '+det+'.']:[]),
  '',
  '📲 *Chame:*',
  ...CONFIG.TELEFONES_ANUNCIO,
  '',
  '👉 _Para ter acesso a este veículo, clique aqui:_',
  'https://'+CONFIG.LINK_CATALOGO+'?placa='+v.placa+ref
 ];
 return L.join('\n');
}
function acha(matrix,placa){
 if(!matrix||!matrix.length)return null;
 const head=matrix[0].map(h=>CAMPOS[norm(h)]||null);
 for(let i=1;i<matrix.length;i++){
  const r={};matrix[i].forEach((c,j)=>{if(head[j]&&r[head[j]]===undefined)r[head[j]]=c});
  if(String(r.placa??'').trim().toUpperCase()!==placa)continue;
  const preco0=toNumber(r.repasse),pr=String(r.promo??'').trim(),prN=toNumber(r.promo);
  const emPromo=!!pr&&!/^(nao|não|n|0|-|nan|#n\/?[ad])$/i.test(pr);
  if(!preco0&&!(emPromo&&prN>1000))continue;
  let preco=preco0;
  if(emPromo&&prN&&prN>1000)preco=prN;
  const bruto=String(r.modelo??'').trim().replace(/\s+/g,' ').replace(/\s+\d{2}\/\d{2}$/,'');
  const ls=norm(r.laudo);
  const laudo=ls.includes('reprov')?'rep':ls.includes('apont')?'apont':ls.includes('aprov')?'ok':'none';
  const fipe=toNumber(r.fipe),uf=String(r.uf??'').trim().toUpperCase();
  let obs=String(r.obs??'').trim();
  if(/^(nao|não|n|0|-|nan|nenhuma?|#n\/?[ad]|#ref!?|#valor!?|#value!?)$/i.test(obs))obs='';
  obs=obs.replace(/^!+\s*/,'');
  const validade=parseValidade(r.validade);
  return{placa,bruto,ano:String(r.ano??'').trim(),km:kmNumber(r.km),uf:UFS.has(uf)?uf:'',laudo,fipe:fipe&&fipe>0?fipe:null,preco,validade,encerrado:!!(validade&&Date.now()>=validade),obs,
   ipva:String(r.ipva??'').trim(),pneus:String(r.pneus??'').trim(),manual:String(r.manual??'').trim(),detalhes:String(r.detalhes??'').trim()};
 }
 return null;
}
return{parseDelimited,acha,adLer,adTexto};
})();
let PLAN=null;
async function carregaPlanilhas(force){
 if(PLAN&&!force)return PLAN;
 PLAN=await Promise.all(CFG.PLANILHAS.map(async u=>{try{const r=await fetch(u,{cache:'no-cache'});if(!r.ok)return null;return CAT.parseDelimited(await r.text())}catch(e){return null}}));
 return PLAN;
}
function atualizaAd(c){
 const ta=c.el.querySelector('[data-adtxt]'),st=c.el.querySelector('[data-adst]');
 if(ta&&document.activeElement!==ta)ta.value=c.adTxt||'';
 if(st)st.textContent=c.adSt||'';
}
async function buscaAd(c,force){
 if(!/^[A-Z0-9]{7}$/.test(c.placa||'')){c.adSt='Digite a placa (7 caracteres) para buscar o anúncio.';atualizaAd(c);return}
 c.adSt='Buscando nas planilhas…';atualizaAd(c);
 const placa=c.placa,pl=await carregaPlanilhas(force);
 if(placa!==c.placa)return;
 if(pl.every(x=>!x)){c.adSt='Não consegui ler as planilhas (sem internet?). Toque em “Buscar de novo”.';atualizaAd(c);return}
 let v=null;for(const m of pl){v=CAT.acha(m,placa);if(v)break}
 if(!v){c.adSt='Placa '+placa+' não encontrada nas planilhas. Confira a placa ou escreva o anúncio aqui.';atualizaAd(c);return}
 const g=CAT.adLer();
 const dif=v.fipe&&v.fipe>v.preco?Math.floor((v.fipe-v.preco)/500)*500:0;
 c.adTxt=CAT.adTexto(v,{pneus:v.pneus||g.pneus,manual:v.manual||g.manual,ipva:v.ipva||g.ipva,desc:dif>0?dif.toLocaleString('pt-BR'):'',det:v.detalhes||''});
 c.adSt=v.encerrado?'⚠ O prazo (Validade) deste carro já venceu na planilha.':'Anúncio montado a partir da planilha. Pode editar o texto.';
 atualizaAd(c);
}
async function copiaTexto(c){
 const t=c.adTxt||'';if(!t)return false;
 try{await navigator.clipboard.writeText(t);return true}
 catch(e){const ta=c.el.querySelector('[data-adtxt]');if(ta){ta.select();try{return document.execCommand('copy')}catch(_){}}return false}
}
function prepara(c){clearTimeout(c.tPrep);c.tPrep=setTimeout(()=>{arquivosDe(c).catch(()=>{})},700)}

/* ============ LEITURA DO PDF ============ */
let pdfjsLib=null;
function carregarPdfJs(){
 if(pdfjsLib)return Promise.resolve(pdfjsLib);
 return new Promise((ok,no)=>{
  const src=window.PDFJS_SRC||CFG.PDFJS;
  const s=document.createElement('script');s.src=src;
  s.onload=()=>{pdfjsLib=window.pdfjsLib;pdfjsLib.GlobalWorkerOptions.workerSrc=src.replace('pdf.min.js','pdf.worker.min.js');ok(pdfjsLib)};
  s.onerror=()=>no(new Error('Não consegui carregar o leitor de PDF (sem internet?).'));
  document.head.appendChild(s);
 });
}
function imgParaJpeg(img){
 // img: objeto de imagem do pdf.js -> canvas -> blob jpeg
 return new Promise(res=>{
  const c=document.createElement('canvas');
  if(img.bitmap){c.width=img.bitmap.width;c.height=img.bitmap.height;c.getContext('2d').drawImage(img.bitmap,0,0)}
  else{
   const w=img.width,h=img.height;c.width=w;c.height=h;
   const ctx=c.getContext('2d'),out=ctx.createImageData(w,h),d=img.data,o=out.data;
   if(d.length===w*h*4)o.set(d);
   else if(d.length===w*h*3){for(let i=0,j=0;i<d.length;i+=3,j+=4){o[j]=d[i];o[j+1]=d[i+1];o[j+2]=d[i+2];o[j+3]=255}}
   else if(d.length===w*h){for(let i=0,j=0;i<d.length;i++,j+=4){o[j]=o[j+1]=o[j+2]=d[i];o[j+3]=255}}
   else return res(null);
   ctx.putImageData(out,0,0);
  }
  const t=document.createElement('canvas');t.width=320;t.height=Math.round(c.height*320/c.width);t.getContext('2d').drawImage(c,0,0,t.width,t.height);
  const thumb=t.toDataURL('image/jpeg',.72);
  const k=Math.min(1,CFG.LARGURA/c.width),o2=document.createElement('canvas');o2.width=Math.round(c.width*k);o2.height=Math.round(c.height*k);
  o2.getContext('2d').drawImage(c,0,0,o2.width,o2.height);c.width=c.height=0;t.width=t.height=0;
  o2.toBlob(b=>res(b?{blob:b,w:o2.width,h:o2.height,thumb}:null),'image/jpeg',.85);
 });
}
function mulM(a,b){return[a[0]*b[0]+a[1]*b[2],a[0]*b[1]+a[1]*b[3],a[2]*b[0]+a[3]*b[2],a[2]*b[1]+a[3]*b[3],a[4]*b[0]+a[5]*b[2]+b[4],a[4]*b[1]+a[5]*b[3]+b[5]]}
async function lerPdf(file){
 const lib=await carregarPdfJs();
 const pdf=await lib.getDocument({data:await file.arrayBuffer()}).promise;
 const OPS=lib.OPS,fotos=[];let textoTodo='';
 for(let p=1;p<=pdf.numPages;p++){
  const page=await pdf.getPage(p);
  const tc=await page.getTextContent();
  const itens=tc.items.filter(t=>t.str&&t.str.trim()).map(t=>({s:t.str.trim(),x:t.transform[4],y:t.transform[5],w:t.width}));
  textoTodo+=' '+itens.map(i=>i.s).join(' ');
  const ol=await page.getOperatorList();
  let ctm=[1,0,0,1,0,0];const pilha=[];const caixas=[];
  for(let i=0;i<ol.fnArray.length;i++){
   const fn=ol.fnArray[i],ar=ol.argsArray[i];
   if(fn===OPS.save)pilha.push(ctm.slice());
   else if(fn===OPS.restore)ctm=pilha.pop()||[1,0,0,1,0,0];
   else if(fn===OPS.transform)ctm=mulM(ar,ctm);
   else if(fn===OPS.paintImageXObject||fn===OPS.paintJpegXObject){caixas.push({nome:ar[0],x:ctm[4],y:ctm[5],w:Math.abs(ctm[0]),h:Math.abs(ctm[3])})}
  }
  for(const cx of caixas){
   if(cx.w<150||cx.h<110)continue; // ignora logos e ícones
   let img=null;
   try{img=await new Promise((ok,no)=>{const t=setTimeout(()=>no(),4000);page.objs.get(cx.nome,o=>{clearTimeout(t);ok(o)})})}catch(e){}
   if(!img&&page.commonObjs){try{img=page.commonObjs.get(cx.nome)}catch(e){}}
   if(!img||!(img.width>=400))continue;
   const j=await imgParaJpeg(img);if(!j)continue;
   // legenda: texto mais perto, na mesma coluna (acima ou abaixo da foto)
   const colA=cx.x,colB=cx.x+cx.w;
   let cand=itens.filter(t=>{const cx2=t.x+(t.w||0)/2;return cx2>colA-10&&cx2<colB+10&&(Math.abs(t.y-(cx.y+cx.h))<45||Math.abs(t.y-cx.y)<45)});
   cand=cand.filter(t=>!/^(FOTOGRAFIAS|N[úu]mero|Vistoriador|Auxiliar)/i.test(t.s));
   cand.sort((a,b)=>Math.min(Math.abs(a.y-(cx.y+cx.h)),Math.abs(a.y-cx.y))-Math.min(Math.abs(b.y-(cx.y+cx.h)),Math.abs(b.y-cx.y)));
   let leg='';
   if(cand.length){
    const ref=cand[0];
    leg=cand.filter(t=>Math.abs(t.y-ref.y)<=16).sort((a,b)=>b.y-a.y).map(t=>t.s).join(' ');
   }
   fotos.push({pag:p,x:cx.x,y:cx.y,rotulo:norm(leg),blob:j.blob,w:j.w,h:j.h,url:j.thumb});
  }
 }
 // ordem de leitura: página, de cima para baixo, esquerda para direita
 fotos.sort((a,b)=>a.pag-b.pag||(Math.round(b.y/40)-Math.round(a.y/40))||a.x-b.x);
 const m=textoTodo.match(/PLACA:?\s*([A-Z]{3}[0-9][A-Z0-9][0-9]{2})/i)||textoTodo.match(/\b([A-Z]{3}[0-9][A-Z][0-9]{2}|[A-Z]{3}[0-9]{4})\b/);
 let placa=m?m[1].toUpperCase():'';
 if(!placa){const f=file.name.match(/([A-Za-z]{3}[0-9][A-Za-z0-9][0-9]{2})/);if(f)placa=f[1].toUpperCase()}
 const mod=textoTodo.match(/MODELO\/VERS[ÃA]O:\s*(.+?)\s+(ANO|COR|PLACA)/i);
 const km=textoTodo.match(/\bKM:\s*([0-9.]+)/);
 return{placa,fotos,modelo:mod?mod[1]:'',km:km?km[1]:''};
}

/* ============ TELA ============ */
const CARROS=[];
function escolhaAutomatica(fotos){
 const escolhidas=[];
 for(const [nome,re] of PADRAO){
  const i=fotos.findIndex((f,ix)=>re.test(f.rotulo)&&!escolhidas.some(e=>e.i===ix));
  if(i>=0)escolhidas.push({i,nome});
 }
 return escolhidas;
}
function desenhar(c){
 const el=c.el;
 el.innerHTML=`<div class="car-h"><span class="placa">${esc(c.placa||'?')}</span><input class="fld" data-placa placeholder="Placa" value="${esc(c.placa)}" maxlength="8"><span class="info">${esc(c.modelo)}${c.km?' · '+esc(c.km)+' km':''} · ${c.fotos.length} fotos no PDF</span><button class="btn ghost" data-rem>Remover</button></div>
 <div class="sel">${c.fotos.map((f,i)=>{const pos=c.ordem.indexOf(i);return`<div class="ph${pos>=0?' on':''}" data-i="${i}"><img src="${f.url}" loading="lazy"><span class="n">${pos+1}</span><span class="l">${esc(c.nomes[i]||f.rotulo||'sem nome')}</span><button class="tar${(c.tarjas[i]||[]).length?' ok':''}" data-tar="${i}">${(c.tarjas[i]||[]).length?'✔ Placa tampada':'Tampar placa'}</button></div>`}).join('')}</div>
 <div class="adbox"><div class="car-h" style="margin:14px 0 0"><b>📝 Anúncio</b><span class="st" data-adst>${esc(c.adSt||'')}</span></div><textarea data-adtxt style="min-height:230px;font-size:13px">${esc(c.adTxt||'')}</textarea><div class="acts"><button class="btn ghost" data-adcopy>Copiar anúncio</button><button class="btn ghost" data-adrefresh>↻ Buscar de novo</button></div></div>
 <div class="acts"><button class="btn ghost" data-modo="1">Só a principal</button><button class="btn ghost" data-modo="6">Destaque (6 fotos)</button></div>
 <div class="acts"><button class="btn wa" data-share ${c.ordem.length?'':'disabled'}>📤 Compartilhar</button><button class="btn ghost" data-salvar ${c.ordem.length?'':'disabled'}>💾 Salvar fotos</button></div>
 <div class="acts"><button class="btn" data-pub ${c.ordem.length&&c.placa?'':'disabled'}>🚀 Publicar ${c.ordem.length} foto${c.ordem.length===1?'':'s'}</button><span class="st ${c.stCls||''}" data-st>${esc(c.st||'Clique nas fotos para escolher ou tirar. O número mostra a ordem.')}</span></div>
 ${c.linha?`<textarea readonly data-linha>${esc(c.linha)}</textarea><div class="acts"><button class="btn ghost" data-copiar>📋 Copiar linha para a planilha</button></div>`:''}`;
}
function novoCarro(res,nomeArq){
 const c={...res,nomeArq,nomes:{},ordem:[],tarjas:{},el:document.createElement('div')};
 c.el.className='car';
 const auto=escolhaAutomatica(c.fotos);
 auto.forEach(a=>{c.ordem.push(a.i);c.nomes[a.i]=a.nome});
 c.st=auto.length?`Escolhi ${auto.length} foto${auto.length===1?'':'s'} pelo nome. Confira e publique.`:'Este PDF não traz o nome das fotos: clique nas que você quer, na ordem.';
 $('#lista').appendChild(c.el);CARROS.push(c);desenhar(c);
 c.el.addEventListener('click',e=>onClick(c,e));
 buscaAd(c);prepara(c);
 c.el.addEventListener('input',e=>{if(e.target.matches('[data-adtxt]')){c.adTxt=e.target.value;return}if(e.target.matches('[data-placa]')){clearTimeout(c.tAd);c.tAd=setTimeout(()=>buscaAd(c),600);c.placa=e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,'');e.target.value=c.placa;c.el.querySelector('.placa').textContent=c.placa||'?';c.el.querySelector('[data-pub]').disabled=!(c.ordem.length&&c.placa)}});
}
function onClick(c,e){
 const tb=e.target.closest('[data-tar]');if(tb){abreEd(c,+tb.dataset.tar);return}
 const ph=e.target.closest('.ph');
 if(ph){const i=+ph.dataset.i,k=c.ordem.indexOf(i);if(k>=0){c.ordem.splice(k,1)}else{c.ordem.push(i);if(!c.nomes[i])c.nomes[i]=c.fotos[i].rotulo?c.fotos[i].rotulo.charAt(0)+c.fotos[i].rotulo.slice(1).toLowerCase():'Foto '+(i+1)}
  const pl=c.placa;desenhar(c);c.el.querySelector('[data-placa]').value=pl;prepara(c);return}
 const bc=e.target.closest('[data-adcopy]');if(bc){copiaTexto(c).then(ok=>{bc.textContent=ok?'✔ Copiado!':'Não consegui copiar';setTimeout(()=>bc.textContent='Copiar anúncio',1800)});return}
 if(e.target.closest('[data-adrefresh]')){buscaAd(c,true);return}
 const mo=e.target.closest('[data-modo]');if(mo){aplicaModo(c,+mo.dataset.modo);return}
 if(e.target.closest('[data-share]')){compartilhar(c);return}
 if(e.target.closest('[data-salvar]')){salvarFotos(c);return}
 if(e.target.closest('[data-rem]')){c.el.remove();CARROS.splice(CARROS.indexOf(c),1);return}
 if(e.target.closest('[data-pub]')){publicar(c);return}
 if(e.target.closest('[data-copiar]')){const t=c.el.querySelector('[data-linha]');t.select();try{navigator.clipboard.writeText(t.value)}catch(err){document.execCommand('copy')}e.target.textContent='✅ Copiado';return}
}
function redimensionar(f){
 return new Promise(res=>{
  createImageBitmap(f.blob).then(im=>{
   const k=Math.min(1,CFG.LARGURA/im.width),c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);
   c.getContext('2d').drawImage(im,0,0,c.width,c.height);c.toBlob(b=>res(b),'image/jpeg',.85)});
 });
}
async function subir(blob,placa,n){
 const tentar=async(comId)=>{
  const fd=new FormData();fd.append('file',blob,`${placa}_${n}.jpg`);fd.append('upload_preset',CFG.PRESET);
  if(comId){fd.append('public_id',`${placa}_${n}`);fd.append('folder',`${CFG.PASTA}/${placa}`)}
  const r=await fetch(`https://api.cloudinary.com/v1_1/${CFG.CLOUD}/image/upload`,{method:'POST',body:fd});
  const j=await r.json();if(!r.ok)throw new Error(j&&j.error?j.error.message:'erro '+r.status);return j.secure_url;
 };
 try{return await tentar(true)}catch(e){return await tentar(false)}
}
function desenhaTarjas(g,W,H,ts){
 for(const t of ts){
  const x=t[0]*W,y=t[1]*H,w=t[2]*W,h=t[3]*H;
  g.fillStyle='#0b0b0d';g.fillRect(x,y,w,h);
  g.strokeStyle='#c9a84c';g.lineWidth=Math.max(2,W/400);g.strokeRect(x+1,y+1,w-2,h-2);
  g.fillStyle='#e6c76a';g.font='700 '+Math.max(10,Math.min(h*.5,w*.16))+'px Poppins,system-ui,sans-serif';g.textAlign='center';g.textBaseline='middle';g.fillText('TH',x+w/2,y+h/2);
 }
}
async function fotoFinal(c,i){
 const im=await createImageBitmap(c.fotos[i].blob);
 const k=Math.min(1,CFG.LARGURA/im.width),cv=document.createElement('canvas');
 cv.width=Math.round(im.width*k);cv.height=Math.round(im.height*k);
 const g=cv.getContext('2d');g.drawImage(im,0,0,cv.width,cv.height);
 desenhaTarjas(g,cv.width,cv.height,c.tarjas[i]||[]);
 return new Promise(res=>cv.toBlob(res,'image/jpeg',.85));
}
const PLACA_RE=/DIANTEIRA|TRASEIRA/;
function confirmaPlaca(c){
 const sem=c.ordem.filter(i=>{const r=c.fotos[i].rotulo;return(r?PLACA_RE.test(r):true)&&!(c.tarjas[i]&&c.tarjas[i].length)});
 if(!sem.length)return true;
 const nomes=sem.map(i=>c.nomes[i]||c.fotos[i].rotulo||'Foto '+(i+1)).join(', ');
 return confirm('Atenção: estas fotos podem mostrar a placa e estão sem tarja: '+nomes+'.\n\nEnviar mesmo assim?');
}
/* editor de tarja */
let ED=null;
async function abreEd(c,i){
 const im=await createImageBitmap(c.fotos[i].blob),cv=$('#edCv');
 cv.width=im.width;cv.height=im.height;
 ED={c,i,im,ts:(c.tarjas[i]||[]).map(t=>t.slice()),cur:null,p0:null};
 $('#ed').style.display='flex';pintaEd();
}
function pintaEd(){const cv=$('#edCv'),g=cv.getContext('2d');g.drawImage(ED.im,0,0,cv.width,cv.height);desenhaTarjas(g,cv.width,cv.height,ED.cur?ED.ts.concat([ED.cur]):ED.ts)}
function ptEd(e){const r=$('#edCv').getBoundingClientRect();return[Math.min(1,Math.max(0,(e.clientX-r.left)/r.width)),Math.min(1,Math.max(0,(e.clientY-r.top)/r.height))]}
function fechaEd(salvar){
 if(salvar){ED.c.tarjas[ED.i]=ED.ts;ED.c.cache=null;desenhar(ED.c);prepara(ED.c)}
 $('#ed').style.display='none';ED=null;
}
const edCv=$('#edCv');
edCv.addEventListener('pointerdown',e=>{if(!ED)return;e.preventDefault();edCv.setPointerCapture(e.pointerId);ED.p0=ptEd(e);ED.cur=[ED.p0[0],ED.p0[1],0,0];pintaEd()});
edCv.addEventListener('pointermove',e=>{if(!ED||!ED.p0)return;const p=ptEd(e);ED.cur=[Math.min(ED.p0[0],p[0]),Math.min(ED.p0[1],p[1]),Math.abs(p[0]-ED.p0[0]),Math.abs(p[1]-ED.p0[1])];pintaEd()});
const fimTraco=()=>{if(!ED||!ED.p0)return;if(ED.cur&&ED.cur[2]>.015&&ED.cur[3]>.015)ED.ts.push(ED.cur);ED.cur=null;ED.p0=null;pintaEd()};
edCv.addEventListener('pointerup',fimTraco);edCv.addEventListener('pointercancel',fimTraco);
$('#edDesf').onclick=()=>{if(ED){ED.ts.pop();pintaEd()}};
$('#edLimpa').onclick=()=>{if(ED){ED.ts=[];pintaEd()}};
$('#edOk').onclick=()=>fechaEd(true);
function aplicaModo(c,n){
 const auto=escolhaAutomatica(c.fotos);let lista=auto.slice(0,n);
 if(!lista.length)lista=c.fotos.slice(0,n).map((f,i)=>({i,nome:'Foto '+(i+1)}));
 c.ordem=[];lista.forEach(a=>{c.ordem.push(a.i);c.nomes[a.i]=a.nome});
 c.st=c.ordem.length+' foto'+(c.ordem.length===1?'':'s')+' escolhida'+(c.ordem.length===1?'':'s')+'.';c.stCls='';desenhar(c);prepara(c);
}
async function arquivosDe(c){
 const key=c.ordem.join(',')+'|'+c.placa+'|'+JSON.stringify(c.tarjas);
 if(c.cache&&c.cache.key===key)return c.cache.files;
 const out=[];
 for(let k=0;k<c.ordem.length;k++){const b=await fotoFinal(c,c.ordem[k]);out.push(new File([b],(c.placa||'carro')+'_'+(k+1)+'.jpg',{type:'image/jpeg'}))}
 c.cache={key,files:out};return out;
}
async function compartilhar(c){
 if(!confirmaPlaca(c))return;
 const st=c.el.querySelector('[data-st]');st.className='st';st.textContent='Preparando fotos…';
 try{
  const pCop=copiaTexto(c);
  const files=await arquivosDe(c);
  const copiou=await pCop;
  if(navigator.canShare&&navigator.canShare({files})){st.textContent=copiou?'Texto copiado. Cole na legenda do WhatsApp.':'Fotos prontas.';await navigator.share({files});return}
  st.textContent='Este aparelho não compartilha direto. Use “Salvar fotos”.';st.className='st err';
 }catch(e){
  if(e&&e.name==='AbortError'){st.textContent='';return}
  if(e&&e.name==='NotAllowedError'){st.textContent='Fotos prontas. Toque em Compartilhar de novo.';st.className='st ok';return}
  st.textContent='Não consegui compartilhar: '+(e.message||e);st.className='st err';
 }
}
async function salvarFotos(c){
 if(!confirmaPlaca(c))return;
 const st=c.el.querySelector('[data-st]');st.className='st';st.textContent='Preparando fotos…';
 try{
  const files=await arquivosDe(c);
  for(const f of files){const a=document.createElement('a');a.href=URL.createObjectURL(f);a.download=f.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),4000);await new Promise(r=>setTimeout(r,400))}
  st.textContent='Fotos baixadas. No celular, ficam em Downloads ou Arquivos.';st.className='st ok';
 }catch(e){st.textContent='Não consegui salvar: '+(e.message||e);st.className='st err'}
}
async function publicar(c){
 if(!confirmaPlaca(c))return;
 const btn=c.el.querySelector('[data-pub]'),st=c.el.querySelector('[data-st]');btn.disabled=true;
 const urls=[];
 try{
  for(let k=0;k<c.ordem.length;k++){
   st.className='st';st.textContent=`Enviando foto ${k+1} de ${c.ordem.length}…`;
   const b=await fotoFinal(c,c.ordem[k]);
   const u=await subir(b,c.placa,k+1);
   urls.push((c.nomes[c.ordem[k]]||'Foto '+(k+1))+'::'+u.replace('/upload/','/upload/f_auto,q_auto/'));
  }
 }catch(e){c.st='Não consegui enviar: '+e.message;c.stCls='err';desenhar(c);return}
 c.linha=c.placa+'\t'+urls.join(' | ');
 PUB[c.placa]=c.linha;salvaPub();desenhaPub();
 c.st=`✅ ${c.placa}: ${urls.length} foto${urls.length===1?'':'s'} publicada${urls.length===1?'':'s'}. A linha já está na caixa “Para colar na planilha”, lá em cima.`;c.stCls='ok';
 desenhar(c);
}
async function receber(files){
 for(const f of files){
  if(!/pdf$/i.test(f.type)&&!/\.pdf$/i.test(f.name))continue;
  const tmp=document.createElement('div');tmp.className='car';tmp.innerHTML=`<span class="st">Lendo ${esc(f.name)}…</span>`;$('#lista').appendChild(tmp);
  try{const r=await lerPdf(f);tmp.remove();if(!r.fotos.length){const e=document.createElement('div');e.className='car';e.innerHTML=`<span class="st err">${esc(f.name)}: não encontrei fotos neste PDF.</span>`;$('#lista').appendChild(e)}else novoCarro(r,f.name)}
  catch(e){tmp.innerHTML=`<span class="st err">${esc(f.name)}: ${esc(e.message||'erro ao ler')}</span>`}
 }
}
const drop=$('#drop'),arq=$('#arq');
drop.onclick=()=>arq.click();arq.onchange=()=>{receber([...arq.files]);arq.value=''};
drop.ondragover=e=>{e.preventDefault();drop.classList.add('over')};drop.ondragleave=()=>drop.classList.remove('over');
drop.ondrop=e=>{e.preventDefault();drop.classList.remove('over');receber([...e.dataTransfer.files])};
window.__lerPdf=lerPdf;
</script>
